# Copy to .env (git-ignored) and fill in real values.
# PostgreSQL credentials (also used by the API, DB controller, collector and updater)
POSTGRES_USER=
POSTGRES_PASSWORD=
# API key for the reporting API (src/api/app.py)
API_KEY=
# Default IP camera credentials (used when a camera's username/password is null in camera_configuration.json)
CAM_USERNAME=
CAM_PASSWORD=
# Host IPs used by set_configuration.sh to pick the INSTITUTE
ABESIT_HOST_IP=
GLBITM_HOST_IP=
