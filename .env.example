# Copy to .env (git-ignored) and fill in real values.
# PostgreSQL credentials (also used by the API, DB controller, collector and updater)
POSTGRES_USER=
POSTGRES_PASSWORD=
# API key for the reporting API (src/api/app.py)
API_KEY=
# Default IP camera credentials (used when a camera's username/password is null in camera_configuration.json)
CAM_USERNAME=
CAM_PASSWORD=
# Host IPs used by set_configuration.sh to pick the INSTITUTE
ABESIT_HOST_IP=
GLBITM_HOST_IP=
# Host profile from STANDALONE-SERVICES/hosts/ (GPU placement, batch sizes); empty uses the A100/MIG defaults
HOST_PROFILE=

# Host port for the stack's Postgres when 5432 is taken on this machine (e.g. by a native PostgreSQL); default 5432
POSTGRES_HOST_PORT=
# Dataset store (MinIO, the DVC remote for the face datasets): root login and the host folder that holds the data, outside the repo (e.g. C:/data/dataset-store)
DATASET_STORE_USER=
DATASET_STORE_PASSWORD=
DATASET_STORE_DIR=
