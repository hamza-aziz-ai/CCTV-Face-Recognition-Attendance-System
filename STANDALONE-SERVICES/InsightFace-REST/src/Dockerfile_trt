# TensorRT 26.03: CUDA 13.2, TensorRT 10.16, Python 3.12, Ubuntu 24.04, for amd64 and arm64. The same TensorRT as the Jetson's
# JetPack 7.2.1 and DeepStream 9.1, and its arm64 build runs on the Orin Nano, so one Dockerfile serves both (D-046)
FROM nvcr.io/nvidia/tensorrt:26.03-py3@sha256:ade1b30517b3d66b911a3cd7faf0146484ab8956098abe66b96b944fa36f4861

ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Kolkata
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && apt-get update && apt-get install -y tzdata

ENV PIP_INSTALL="python3 -m pip --no-cache-dir install"

RUN apt-get update &&\
    apt-get install -y\
            libgl1 \
            protobuf-compiler \
            libprotoc-dev \
            libb64-0d \
            libturbojpeg \
            ffmpeg &&\
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN $PIP_INSTALL -r requirements.txt
# GPU specific packages; pynvjpeg has no wheel for this Python and builds against the installed Cython
RUN $PIP_INSTALL cupy-cuda13x cython setuptools && $PIP_INSTALL --no-build-isolation pynvjpeg

WORKDIR /app
COPY if_rest /app/if_rest
COPY entrypoint.sh /app/entrypoint.sh
# GET /health recognises test_images/Stallone.jpg under root_images_dir (/images); without it the self-check always failed
COPY test_images/Stallone.jpg /images/test_images/Stallone.jpg

ENTRYPOINT [ "bash" ]
CMD ["entrypoint.sh"]
