# Host profile: single NVIDIA GeForce RTX 4050 Laptop GPU (6 GB, no MIG) under Docker Desktop.
# Loaded after ../standalone-services.env when HOST_PROFILE=laptop-rtx4050 is set in the root .env (D-015).
# Only GPU placement and engine batch sizes change; models, thresholds and ports stay as in the base file.

# Both InsightFace-REST containers share GPU 0, so the nginx load balancer keeps its two backends
MIG_GPU=("0" "0")
INSIGHTFACE_GPU_DEVICE_0="0"
INSIGHTFACE_GPU_DEVICE_1="0"
N_WORKERS=1

# ponytail: starting guesses for 6 GB shared by two TensorRT containers and Milvus; tune after the first run
DETECTION_BATCH_SIZE=8
RECOGNITION_BATCH_SIZE=16

MILVUS_GPU_DEVICE="0"
FACE_LIVENESS_DETECTION_GPU_DEVICE_0="0"
FACE_LIVENESS_DETECTION_GPU_DEVICE_1="0"
